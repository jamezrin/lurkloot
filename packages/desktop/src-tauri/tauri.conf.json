{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lurkloot",
  "version": "../../../package.json",
  "identifier": "name.jamezrin.lurkloot",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/": "sidecar/"
    },
    "category": "Utility",
    "shortDescription": "Farms Twitch and Kick drops in the background",
    "license": "Apache-2.0",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBNTRCQjhCN0Q3M0Y0RjcKUldUMzlITjlpN3RVV3E2djlPN3doL3Y3anlQZTYxSnVhZ29ObExsNDBsYk9qT2x0anE0TmM3Y2QK",
      "endpoints": [
        "https://github.com/jamezrin/lurkloot/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
