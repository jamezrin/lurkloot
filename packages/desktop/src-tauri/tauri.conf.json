{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lurkloot",
  "version": "../../../package.json",
  "identifier": "name.jamezrin.lurkloot",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/": "sidecar/"
    },
    "category": "Utility",
    "shortDescription": "Farms Twitch and Kick drops in the background",
    "license": "Apache-2.0"
  }
}
