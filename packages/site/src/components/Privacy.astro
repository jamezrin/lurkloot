---
import type { SiteCopy } from "../copy/types.ts";

interface Props {
  copy: SiteCopy;
}
const { copy } = Astro.props;
const guarantees = copy.privacyHome.guarantees;
---

<section id="privacy" class="priv act">
  <div class="wrap priv__inner">
    <div class="priv__head">
      <p class="eyebrow reveal">{copy.privacyHome.eyebrow}</p>
      <h2 class="reveal-slow" set:html={copy.privacyHome.title} />
      <p class="reveal">
        {copy.privacyHome.deck}
      </p>
    </div>
    <ul class="priv__list">
      {guarantees.map((g) => (
        <li class:list={["reveal", { wide: "wide" in g && Boolean(g.wide) }]}>
          <span class="priv__mark">✓</span>
          <div>
            <strong>{g.t}</strong>
            <p>{g.d}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .priv__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 900px) {
    .priv__inner { grid-template-columns: 0.9fr 1.1fr; }
    .priv__head { position: sticky; top: 96px; }
  }
  .priv__head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin: 0.6rem 0 1rem;
  }
  .priv__head p {
    color: var(--muted);
    font-size: 1.08rem;
    max-width: 42ch;
  }
  .priv__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 560px) {
    .priv__list { grid-template-columns: 1fr 1fr; }
    .priv__list li.wide { grid-column: 1 / -1; }
  }
  .priv__list li {
    display: flex;
    gap: 0.9rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: linear-gradient(180deg, var(--ink-1), var(--ink-0));
  }
  .priv__mark {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    display: grid;
    place-content: center;
    font-size: 0.9rem;
    font-weight: 700;
    color: #0a0612;
    background: var(--signal);
  }
  .priv__list strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .priv__list p {
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
