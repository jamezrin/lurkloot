---
// Opening: the headline and calls to action on the left, the Lurkloot mark
// glowing in the middle and what it does on the right, with the real popup in
// a framed window below.
import { LINKS, SITE } from "../../consts";
import PopupDemo from "../../popup-ui/PopupDemo";
---
<section class="sg-hero" aria-labelledby="home-title" data-hero>
  <div class="sg-hero__stage">
    <a class="sg-announce" href={LINKS.changelog}>
      <span>Lurkloot {SITE.version} is out</span>
      <strong>See what's new <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></strong>
    </a>
    <div class="sg-wrap sg-hero__grid">
      <div class="sg-hero__copy">
        <h1 id="home-title">Your drops.<br /><span class="sg-dim">On autopilot.</span></h1>
        <div class="sg-hero__actions">
          <a class="sg-pill sg-pill--lg" href={LINKS.chrome} target="_blank" rel="noopener">Get Lurkloot — free</a>
          <a class="sg-pill sg-pill--lg sg-pill--ghost" href="#demo">Explore the demo</a>
        </div>
      </div>
      <div class="sg-hero__mark" aria-hidden="true">
        <span class="sg-hero__halo"></span>
        <span class="sg-hero__glyph">
          <svg viewBox="0 0 128 128" fill="none">
            <circle cx="64" cy="64" r="34" stroke="currentColor" stroke-opacity=".22" stroke-width="9" />
            <path d="M64 30 A34 34 0 1 1 36.2 83.9" stroke="currentColor" stroke-width="9" stroke-linecap="round" />
            <path fill="currentColor" d="M55 50 C55 47.2 58.1 45.6 60.4 47.1 L81 60.9 C83.1 62.3 83.1 65.7 81 67.1 L60.4 80.9 C58.1 82.4 55 80.8 55 78 Z" />
          </svg>
        </span>
      </div>
      <div class="sg-hero__aside">
        <p class="sg-hero__lede">Farm Twitch and Kick drops, claim rewards, and keep your favourites in order. <span>All from one quiet little workspace.</span></p>
        <ul class="sg-hero__list" aria-label="Product essentials">
          <li><span class="sg-dot sg-dot--twitch"></span>Twitch + Kick</li>
          <li><span class="sg-dot sg-dot--white"></span>Automatic claiming</li>
          <li><span class="sg-dot sg-dot--white"></span>Free &amp; open source</li>
        </ul>
        <p class="sg-hero__note">No Lurkloot account. No subscription. Just install.</p>
      </div>
    </div>
  </div>

  <div class="sg-wrap sg-demo" id="demo" data-rise>
    <div class="sg-demo__card">
      <div class="sg-demo__bar">
        <span class="sg-demo__lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="sg-demo__title">Your workspace, at a glance</span>
        <button class="sg-demo__zoom" type="button" aria-pressed="false" aria-controls="popup-viewport">Enlarge demo</button>
      </div>
      <div class="sg-demo__viewport" id="popup-viewport" data-lenis-prevent>
        <div class="sg-demo__scaler"><PopupDemo frameless client:load /></div>
      </div>
    </div>
    <p class="sg-demo__note">Interactive preview · sample data · no real farming</p>
  </div>
</section>

<script>
  // Scale the real 720 × 600 workspace to its container, including on mobile.
  // Reserving the scaled height prevents clipping and layout gaps.
  const viewport = document.querySelector<HTMLElement>(".sg-demo__viewport");
  if (viewport) {
    const observer = new ResizeObserver(([entry]) => {
      viewport.style.setProperty("--popup-scale", String(Math.min(1, entry.contentRect.width / 720)));
    });
    observer.observe(viewport);
    const zoom = document.querySelector<HTMLButtonElement>(".sg-demo__zoom");
    zoom?.addEventListener("click", () => {
      const expanded = zoom.getAttribute("aria-pressed") !== "true";
      zoom.setAttribute("aria-pressed", String(expanded));
      zoom.textContent = expanded ? "Fit to screen" : "Enlarge demo";
      viewport.dataset.expanded = String(expanded);
      viewport.tabIndex = expanded ? 0 : -1;
      if (expanded) viewport.setAttribute("aria-label", "Full-size popup preview. Scroll horizontally to explore.");
      else viewport.removeAttribute("aria-label");
    });
  }
</script>
