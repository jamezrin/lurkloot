---
// The site's sticky header: the shared bar (SiteBar.astro), the phone menu and,
// on a page with sections (the homepage), a row to jump between them.
import { LINKS, NAV_LINKS } from "../../consts";
import logo from "../../assets/logo-ring.svg";
import SiteBar from "./SiteBar.astro";
import { GITHUB_ICON_PATH as githubPath, STAR_ICON_PATH as starPath } from "./icons";

interface Section {
  href: string;
  label: string;
  badge?: string;
}
interface Props {
  // Links to sections of this page, each "#<section id>".
  sections?: Section[];
}
const { sections = [] } = Astro.props;
const links = [{ href: "/", label: "Home" }, ...NAV_LINKS];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="sg-nav" id="top" data-nav>
  <div class="sg-wrap">
    <SiteBar>
      <button class="sg-nav__toggle" type="button" slot="end" data-menu-open>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2.5 5.5h11M2.5 10.5h11" /></svg>
        <span class="sg-sr">Open menu</span>
      </button>
    </SiteBar>
  </div>
  {sections.length > 0 && (
    <nav class="sg-subnav" aria-label="On this page" data-subnav>
      <div class="sg-subnav__row">
        <div class="sg-wrap sg-subnav__inner">
          {sections.map((section) => (
            <a href={section.href}>
              {section.label}{section.badge && <span class="sg-badge sg-badge--sm">{section.badge}</span>}
            </a>
          ))}
        </div>
      </div>
    </nav>
  )}
</header>

<dialog class="sg-menu" aria-label="Menu" data-menu data-lenis-prevent>
  <div class="sg-wrap sg-nav__inner">
    <a class="sg-brand" href="/#top" aria-label="Lurkloot home">
      <img src={logo.src} width="26" height="26" alt="" />
      <span>Lurkloot</span>
    </a>
    <button class="sg-nav__toggle" type="button" autofocus data-menu-close>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
      <span class="sg-sr">Close menu</span>
    </button>
  </div>
  <nav class="sg-wrap sg-menu__links" aria-label="Main navigation">
    {links.map((link, index) => (
      <a href={link.href} aria-current={link.href === path ? "page" : undefined} style={`--i: ${index}`}>
        {link.label}
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
      </a>
    ))}
  </nav>
  <div class="sg-wrap sg-menu__end" style={`--i: ${links.length}`}>
    <a class="sg-pill sg-pill--lg" href={LINKS.chrome} target="_blank" rel="noopener">Get Lurkloot</a>
    <a class="sg-pill sg-pill--lg sg-pill--ghost" href={LINKS.github} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={githubPath} /></svg>
      <span>GitHub</span>
      <span class="sg-nav__stars" data-github-stars-wrap hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={starPath} /></svg>
        <span data-github-stars></span><span class="sg-sr"> stars</span>
      </span>
    </a>
  </div>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>("[data-nav]");
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  // The header's real height, for anchor jumps (scroll-padding-top in
  // signal.css, and the smooth scroll in scripts/smooth-scroll.ts).
  // On phones the sections row hangs below the header rather than inside it,
  // so measure down to whichever ends lower.
  if (header) {
    const root = document.documentElement;
    const row = header.querySelector<HTMLElement>(".sg-subnav__row");
    const measure = () => {
      const top = header.getBoundingClientRect().top;
      const bottom = Math.max(header.getBoundingClientRect().bottom, row?.getBoundingClientRect().bottom ?? 0);
      root.style.setProperty("--sg-header-h", `${Math.round(bottom - top)}px`);
    };
    const resize = new ResizeObserver(measure);
    resize.observe(header);
    if (row) resize.observe(row);
  }

  const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
  const opener = document.querySelector("[data-menu-open]");
  if (menu && opener) {
    opener.addEventListener("click", () => menu.showModal());
    for (const control of menu.querySelectorAll("a, [data-menu-close]")) {
      control.addEventListener("click", () => menu.close());
    }
    matchMedia("(min-width: 1101px)").addEventListener("change", (event) => {
      if (event.matches) menu.close();
    });
  }

  const subnav = document.querySelector<HTMLElement>("[data-subnav]");
  if (header && subnav) {
    // On phones the sections row waits below the hero (signal.css), so the
    // first screen is the hero alone.
    const hero = document.querySelector(".sg-hero");
    if (hero) {
      new IntersectionObserver(([entry]) => {
        header.toggleAttribute("data-past-hero", !entry.isIntersecting && entry.boundingClientRect.top < 0);
      }).observe(hero);
    } else header.setAttribute("data-past-hero", "");

    // Marks the section in the middle of the screen, and keeps its link in
    // view when the row scrolls sideways.
    const row = subnav.querySelector<HTMLElement>(".sg-subnav__inner");
    const links = new Map(
      [...subnav.querySelectorAll<HTMLAnchorElement>("a")].map((link) => [link.hash.slice(1), link]),
    );
    const order = [...links.keys()];
    const visible = new Set<string>();
    const mark = (id: string | undefined) => {
      for (const [key, link] of links) {
        if (key !== id) {
          link.removeAttribute("aria-current");
          continue;
        }
        link.setAttribute("aria-current", "location");
        if (row && row.scrollWidth > row.clientWidth) {
          row.scrollTo({
            left: link.offsetLeft - (row.clientWidth - link.offsetWidth) / 2,
            behavior: reduceMotion.matches ? "auto" : "smooth",
          });
        }
      }
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        mark(order.find((id) => visible.has(id)));
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    for (const id of order) {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    }
  }
</script>
