---
import { LINKS } from "../../consts";
import logo from "../../assets/logo-ring.svg";

interface Props {
  links?: { href: string; label: string; badge?: string }[];
}
// The homepage links to its own sections; other pages pass their own links.
const {
  links = [
    { href: "#how-it-works", label: "How it works" },
    { href: "#priorities", label: "Priorities" },
    { href: "#platforms", label: "Platforms" },
    { href: "#cli", label: "Headless", badge: "Beta" },
    { href: "#faq", label: "FAQ" },
  ],
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const githubPath =
  "M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z";
const starPath =
  "M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9L12 2.6Z";
---
<header class="sg-nav" id="top" data-nav>
  <div class="sg-wrap sg-nav__inner">
    <a class="sg-brand" href="/#top" aria-label="Lurkloot home">
      <img src={logo.src} width="32" height="32" alt="" />
      <span>Lurkloot</span>
    </a>
    <nav aria-label="Main navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={link.href === path ? "page" : undefined}>
          {link.label}{link.badge && <span class="sg-badge sg-badge--sm">{link.badge}</span>}
        </a>
      ))}
    </nav>
    <div class="sg-nav__end">
      <a class="sg-pill sg-pill--ghost sg-nav__gh" href={LINKS.github} target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={githubPath} /></svg>
        <span>GitHub</span>
        <span class="sg-nav__stars" data-github-stars-wrap hidden>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={starPath} /></svg>
          <span data-github-stars></span><span class="sg-sr"> stars</span>
        </span>
      </a>
      <a class="sg-pill" href={LINKS.chrome} target="_blank" rel="noopener">Get Lurkloot</a>
      <button class="sg-nav__toggle" type="button" data-menu-open>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2.5 5.5h11M2.5 10.5h11" /></svg>
        <span class="sg-sr">Open menu</span>
      </button>
    </div>
  </div>
</header>

<dialog class="sg-menu" aria-label="Menu" data-menu data-lenis-prevent>
  <div class="sg-wrap sg-nav__inner">
    <a class="sg-brand" href="/#top" aria-label="Lurkloot home">
      <img src={logo.src} width="32" height="32" alt="" />
      <span>Lurkloot</span>
    </a>
    <button class="sg-nav__toggle" type="button" autofocus data-menu-close>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
      <span class="sg-sr">Close menu</span>
    </button>
  </div>
  <nav class="sg-wrap sg-menu__links" aria-label="Main navigation">
    {links.map((link, index) => (
      <a href={link.href} aria-current={link.href === path ? "page" : undefined} style={`--i: ${index}`}>
        {link.label}{link.badge && <span class="sg-badge">{link.badge}</span>}
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
      </a>
    ))}
  </nav>
  <div class="sg-wrap sg-menu__end" style={`--i: ${links.length}`}>
    <a class="sg-pill sg-pill--lg" href={LINKS.chrome} target="_blank" rel="noopener">Get Lurkloot</a>
    <a class="sg-pill sg-pill--lg sg-pill--ghost" href={LINKS.github} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={githubPath} /></svg>
      <span>GitHub</span>
      <span class="sg-nav__stars" data-github-stars-wrap hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={starPath} /></svg>
        <span data-github-stars></span><span class="sg-sr"> stars</span>
      </span>
    </a>
  </div>
</dialog>

<script>
  import "../../scripts/github-stars.ts";

  const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
  const opener = document.querySelector("[data-menu-open]");
  if (menu && opener) {
    opener.addEventListener("click", () => menu.showModal());
    for (const control of menu.querySelectorAll("a, [data-menu-close]")) {
      control.addEventListener("click", () => menu.close());
    }
    matchMedia("(min-width: 1101px)").addEventListener("change", (event) => {
      if (event.matches) menu.close();
    });
  }
</script>
