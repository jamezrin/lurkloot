---
import { SUPPORT_LABELS, type GuideSupport } from "../../guide";

interface Props {
  support: GuideSupport;
}
const { support } = Astro.props;
const hosts = [
  { label: "Browser extension", level: support.extension },
  { label: "CLI and Docker", level: support.cli },
];
---
<aside class="guide-support" aria-label="Where this works" data-pagefind-ignore>
  <dl>
    {hosts.map((host) => (
      <div data-level={host.level}><dt>{host.label}</dt><dd>{SUPPORT_LABELS[host.level]}</dd></div>
    ))}
  </dl>
  {support.note && <p>{support.note}</p>}
</aside>
