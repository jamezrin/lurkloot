---
import { LINKS } from "../consts";
import Brand from "./home/Brand.astro";
interface Props { links?: { href: string; label: string }[]; }
const { links = [] } = Astro.props;
---
<header class="home-nav home-wrap" id="top">
  <Brand />
  <nav aria-label="Main navigation">
    <a href={LINKS.twitchFarmer} aria-current={Astro.url.pathname.includes("twitch-drops-farmer") ? "page" : undefined}>Twitch</a>
    <a href={LINKS.kickFarmer} aria-current={Astro.url.pathname.includes("kick-drops-farmer") ? "page" : undefined}>Kick</a>
    <a href={LINKS.changelog} aria-current={Astro.url.pathname.includes("changelog") ? "page" : undefined}>Changelog</a>
  </nav>
  <a class="home-button home-button--small" href={LINKS.chrome} target="_blank" rel="noopener">Get Lurkloot</a>
</header>
{links.length > 0 && <nav class="guide-section-nav home-wrap" aria-label="On this page">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>}
