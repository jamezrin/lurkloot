---
import { Image } from "astro:assets";
import type { SiteCopy } from "../copy/types.ts";
import pepega from "../assets/memes/pepega.webp";
import gigachad from "../assets/memes/gigachad.webp";

interface Props {
  copy: SiteCopy;
}
const { copy } = Astro.props;
const beats = copy.features.beats;
const more = copy.features.more;
---

<section id="features" class="feat act">
  <div class="wrap">
    <div class="feat__head">
      <p class="eyebrow reveal">{copy.features.eyebrow}</p>
      <h2 class="reveal-slow" set:html={copy.features.title} />
    </div>

    <!-- Beat 1 — tabless -->
    <div class="beat">
      <div class="beat__copy reveal">
        <span class="kicker">{beats[0].kicker}</span>
        <h3>{beats[0].title}</h3>
        <p>
          {beats[0].body}
        </p>
      </div>
      <div class="beat__lift reveal">
        <div class="beat__viz beat__viz--meme" data-tilt>
          <figure class="meme meme--bad">
            <div class="meme__pic"><Image src={pepega} alt="Pepega" widths={[128, 256]} sizes="160px" /></div>
            <figcaption>
              <span class="meme__who">{copy.features.meme.withoutWho}</span>
              <span class="meme__tag">{copy.features.meme.withoutTag}</span>
            </figcaption>
          </figure>
          <span class="meme__vs" aria-hidden="true">{copy.features.meme.vs}</span>
          <figure class="meme meme--good">
            <div class="meme__pic"><Image src={gigachad} alt="Gigachad" widths={[320, 660]} sizes="240px" /></div>
            <figcaption>
              <span class="meme__who">{copy.features.meme.withWho}</span>
              <span class="meme__tag">{copy.features.meme.withTag}</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>

    <!-- Beat 2 — scheduling -->
    <div class="beat">
      <div class="beat__copy reveal">
        <span class="kicker">{beats[1].kicker}</span>
        <h3>{beats[1].title}</h3>
        <p>
          {beats[1].body}
        </p>
      </div>
      <div class="beat__lift reveal">
        <div class="beat__viz beat__viz--sched" data-tilt>
          <div class="sched-strats">
            <span class="schip">{copy.features.scheduler.chips[0]}</span>
            <span class="schip">{copy.features.scheduler.chips[1]}</span>
            <span class="schip schip--on">{copy.features.scheduler.chips[2]}</span>
          </div>
          <ol class="sched-list">
            <li class="srow"><i>⠿</i><b>1</b>Rust<em class="now">{copy.features.scheduler.farmingNow}</em></li>
            <li class="srow"><i>⠿</i><b>2</b>VALORANT<em>{copy.features.scheduler.upNext}</em></li>
            <li class="srow"><i>⠿</i><b>3</b>Fortnite<em>{copy.features.scheduler.idleFallback}</em></li>
          </ol>
          <div class="sched-hint">{copy.features.scheduler.dragHint}</div>
        </div>
      </div>
    </div>

    <!-- Beat 3 — auto-claim -->
    <div class="beat">
      <div class="beat__copy reveal">
        <span class="kicker">{beats[2].kicker}</span>
        <h3>{beats[2].title}</h3>
        <p>
          {beats[2].body}
        </p>
      </div>
      <div class="beat__lift reveal">
        <div class="beat__viz beat__viz--claims" data-tilt>
          <div class="claim"><span class="dot"></span> {copy.features.claims[0].name} <em>{copy.features.claims[0].status}</em></div>
          <div class="claim"><span class="dot"></span> {copy.features.claims[1].name} <em>{copy.features.claims[1].status}</em></div>
          <div class="claim claim--pending"><span></span> {copy.features.claims[2].name} <em>{copy.features.claims[2].status}</em></div>
        </div>
      </div>
    </div>

    <!-- Beat 4 — activity -->
    <div class="beat">
      <div class="beat__copy reveal">
        <span class="kicker">{beats[3].kicker}</span>
        <h3>{beats[3].title}</h3>
        <p>
          {beats[3].body}
        </p>
      </div>
      <div class="beat__lift reveal">
        <div class="beat__viz beat__viz--log" data-tilt>
          <div class="logline"><i>{copy.features.log[0].time}</i><b>{copy.features.log[0].level}</b> {copy.features.log[0].text}</div>
          <div class="logline"><i>{copy.features.log[1].time}</i><b class="ok">{copy.features.log[1].level}</b> {copy.features.log[1].text}</div>
          <div class="logline"><i>{copy.features.log[2].time}</i><b>{copy.features.log[2].level}</b> {copy.features.log[2].text}</div>
        </div>
      </div>
    </div>

    <ul class="feat__more">
      {more.map((m) => (
        <li class="reveal">
          <strong>{m.t}</strong>
          <span>{m.d}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .feat__head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    margin-top: 0.6rem;
  }

  .beat {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    margin-top: clamp(4rem, 10vw, 8rem);
  }
  @media (min-width: 860px) {
    .beat {
      grid-template-columns: 1fr 1fr;
    }
    .beat:nth-child(even) .beat__copy {
      order: 2;
    }
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--purple-soft);
  }
  .beat__copy h3 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    margin: 0.8rem 0 1rem;
  }
  .beat__copy p {
    color: var(--muted);
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    max-width: 42ch;
  }

  /* visuals */
  .beat__viz {
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(124, 58, 237, 0.16), transparent 55%),
      linear-gradient(180deg, var(--ink-1), var(--ink-0));
    box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 0.9);
    display: grid;
    gap: 1rem;
  }
  .viz-row {
    display: grid;
    grid-template-columns: 78px 1fr auto;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .bar {
    height: 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .bar b {
    display: block;
    height: 100%;
    border-radius: 999px;
  }
  .bar--heavy b { background: linear-gradient(90deg, #ff7849, #ff3b6b); }
  .bar--light b { background: var(--signal); }
  .viz-pulse {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line);
  }
  .viz-pulse s {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    opacity: 0.3;
    animation: hb 1.6s infinite;
  }
  .viz-pulse s:nth-child(2) { animation-delay: 0.2s; }
  .viz-pulse s:nth-child(3) { animation-delay: 0.4s; }
  .viz-pulse s:nth-child(4) { animation-delay: 0.6s; }
  .viz-pulse s:nth-child(5) { animation-delay: 0.8s; }
  .viz-pulse em {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--faint);
    font-style: normal;
  }
  @keyframes hb {
    0%, 100% { opacity: 0.25; transform: scale(1); }
    40% { opacity: 1; transform: scale(1.5); box-shadow: 0 0 10px var(--glow-lime); }
  }

  /* meme face-off: Pepega (without) vs Gigachad (with) */
  .beat__viz--meme {
    grid-auto-flow: column;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.4rem);
  }
  .meme {
    margin: 0;
    display: grid;
    gap: 0.7rem;
    text-align: center;
  }
  .meme__pic {
    aspect-ratio: 1;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .meme:hover .meme__pic {
    transform: translateY(-6px);
  }
  .meme--bad:hover .meme__pic {
    border-color: rgba(255, 59, 107, 0.45);
    box-shadow: 0 22px 50px -28px rgba(255, 59, 107, 0.6);
  }
  .meme--good:hover .meme__pic {
    border-color: rgba(83, 252, 24, 0.45);
    box-shadow: 0 0 0 1px rgba(83, 252, 24, 0.3), 0 32px 64px -32px var(--glow-lime);
  }
  @media (prefers-reduced-motion: reduce) {
    .meme:hover .meme__pic {
      transform: none;
    }
    .meme:hover .meme__pic :global(img) {
      transform: none;
    }
  }
  .meme__pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .meme:hover .meme__pic :global(img) {
    transform: scale(1.12);
  }
  .meme--bad .meme__pic {
    background: radial-gradient(120% 120% at 50% 0%, rgba(255, 59, 107, 0.18), var(--ink-2));
    filter: saturate(0.9);
  }
  /* pepega is wider than tall — show it whole instead of cropping the sides */
  .meme--bad .meme__pic :global(img) {
    object-fit: contain;
  }
  .meme--good .meme__pic {
    background: radial-gradient(120% 120% at 50% 0%, rgba(83, 252, 24, 0.16), var(--ink-2));
    box-shadow: 0 0 0 1px rgba(83, 252, 24, 0.18), 0 30px 60px -40px var(--glow-lime);
  }
  .meme figcaption {
    display: grid;
    gap: 0.2rem;
  }
  .meme__who {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
  }
  .meme--good .meme__who {
    background: var(--signal-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .meme__tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  .meme__vs {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    align-self: center;
  }

  .beat__viz--sched {
    align-content: center;
    gap: 0.9rem;
  }
  .sched-strats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .schip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.45em 0.85em;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--faint);
  }
  .schip--on {
    border-color: transparent;
    background: var(--signal);
    color: #0a0612;
    font-weight: 600;
  }
  .sched-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .srow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
    padding: 0.65rem 0.9rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--line);
  }
  .srow i {
    font-style: normal;
    color: var(--faint);
    cursor: grab;
  }
  .srow b {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.74rem;
    color: var(--purple-soft);
  }
  .srow em {
    margin-left: auto;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--faint);
  }
  .srow em.now { color: var(--lime); }
  .sched-hint {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--faint);
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line);
  }

  .claim {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--line);
  }
  .claim em { margin-left: auto; font-style: normal; color: var(--lime); font-family: var(--font-mono); font-size: 0.78rem; }
  .claim--pending { opacity: 0.6; }
  .claim--pending span { width: 7px; height: 7px; border-radius: 50%; border: 1px solid var(--faint); }
  .claim--pending em { color: var(--faint); }

  .logline {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
    padding: 0.55rem 0.7rem;
    border-radius: 9px;
    background: var(--void);
    border: 1px solid var(--line);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .logline i { color: var(--faint); margin-right: 0.6rem; font-style: normal; }
  .logline b { color: var(--purple-soft); margin-right: 0.6rem; font-weight: 600; }
  .logline b.ok { color: var(--lime); }

  /* "and more" row */
  .feat__more {
    list-style: none;
    padding: 0;
    margin: clamp(4rem, 9vw, 7rem) 0 0;
    display: grid;
    gap: 1.4rem 2.5rem;
    border-top: 1px solid var(--line);
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 720px) {
    .feat__more {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .feat__more strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }
  .feat__more span {
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
