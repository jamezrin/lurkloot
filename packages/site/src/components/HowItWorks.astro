---
import type { SiteCopy } from "../copy/types.ts";

interface Props {
  copy: SiteCopy;
}
const { copy } = Astro.props;
const steps = copy.how.steps;
---

<section id="how" class="how act">
  <div class="wrap">
    <div class="how__head">
      <p class="eyebrow reveal">{copy.how.eyebrow}</p>
      <h2 class="reveal-slow" set:html={copy.how.title} />
    </div>

    <ol class="how__steps">
      {steps.map((step) => (
        <li class="how__step reveal">
          <span class="how__n">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how__head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    margin-top: 0.6rem;
  }
  .how__steps {
    list-style: none;
    padding: 0;
    margin: clamp(3rem, 7vw, 5.5rem) 0 0;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 820px) {
    .how__steps {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }
  .how__step {
    position: relative;
    padding-top: 2.2rem;
    border-top: 1px solid var(--line-strong);
  }
  .how__n {
    position: absolute;
    top: 2rem;
    right: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--faint);
  }
  .how__step h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.7rem;
  }
  .how__step p {
    color: var(--muted);
    font-size: 1.02rem;
    max-width: 36ch;
  }
</style>
