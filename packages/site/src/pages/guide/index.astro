---
import { getCollection } from "astro:content";
import Base from "../../layouts/SitePage.astro";
import { groupGuide, guideHref } from "../../guide";
import { LINKS } from "../../consts";

const sections = groupGuide(await getCollection("guide"));
---
<Base
  title="User Guide — Lurkloot"
  description="How to install Lurkloot, start farming Twitch and Kick drops, choose what gets farmed, and fix common problems."
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Guide", href: LINKS.guide }]}
>
  <main id="content">
    <header class="document-hero sg-wrap"><p class="document-label">GUIDE</p><h1>Set it up once.<br /><span>Let it farm.</span></h1><p>Everything you need to use Lurkloot, in plain words.</p></header>
    <section class="document-section">
      <div class="sg-wrap guide-index">
        {sections.map((section) => (
          <section class="guide-index__section" aria-labelledby={`guide-${section.id}`}>
            <h2 id={`guide-${section.id}`}>{section.title}</h2>
            <ul>
              {section.pages.map((page) => (
                <li><a href={guideHref(page)}><strong>{page.data.title}</strong><span>{page.data.description}</span></a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </main>
</Base>
