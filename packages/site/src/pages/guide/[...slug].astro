---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/SitePage.astro";
import { EXTERNAL_URLS, LINKS } from "../../consts";
import GuideSupport from "../../components/GuideSupport.astro";
import { SUPPORT_LABELS, groupGuide, guideHref, type GuideEntry } from "../../guide";

export async function getStaticPaths() {
  const entries = await getCollection("guide");
  const ordered = groupGuide(entries).flatMap((section) => section.pages);
  return ordered.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: ordered[index - 1], next: ordered[index + 1] },
  }));
}

interface Props {
  entry: GuideEntry;
  previous?: GuideEntry;
  next?: GuideEntry;
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const sections = groupGuide(await getCollection("guide"));
const sectionTitle = sections.find((section) => section.id === entry.data.section)?.title;
const editUrl = `${EXTERNAL_URLS.github}/edit/develop/packages/site/${entry.filePath}`;
const href = guideHref(entry);
const supportRows = entry.data.supportTable
  ? sections.flatMap((section) =>
      section.pages.flatMap((page) => (page.data.support ? [{ page, support: page.data.support }] : [])),
    )
  : [];
---
<Base
  title={`${entry.data.title} — Lurkloot Guide`}
  description={entry.data.description}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Guide", href: LINKS.guide },
    { name: entry.data.title, href },
  ]}
>
  <main id="content">
    <header class="document-hero sg-wrap"><p class="document-label"><a href={LINKS.guide}>GUIDE</a><span aria-hidden="true">·</span><span>{sectionTitle?.toUpperCase()}</span></p><h1>{entry.data.title}</h1><p>{entry.data.description}</p></header>
    <section class="document-section">
      <div class="sg-wrap document-layout">
        <details class="guide-nav-toggle" open data-guide-nav>
          <summary>All guide pages</summary>
          <nav class="document-toc guide-nav" aria-label="Guide pages">
          {sections.map((section) => (
            <>
              <p>{section.title}</p>
              {section.pages.map((page) => (
                <a href={guideHref(page)} aria-current={page.id === entry.id ? "page" : undefined}>{page.data.title}</a>
              ))}
            </>
          ))}
          </nav>
        </details>
        <div>
          {entry.data.support && <GuideSupport support={entry.data.support} />}
          <article class="document-prose" aria-label={entry.data.title}>
            <Content />
            {supportRows.length > 0 && (
              <table class="guide-support-table">
                <thead><tr><th scope="col">Feature</th><th scope="col">Extension</th><th scope="col">CLI</th><th scope="col">Notes</th></tr></thead>
                <tbody>
                  {supportRows.map(({ page, support }) => (
                    <tr>
                      <th scope="row"><a href={guideHref(page)}>{page.data.title}</a></th>
                      <td data-level={support.extension}>{SUPPORT_LABELS[support.extension]}</td>
                      <td data-level={support.cli}>{SUPPORT_LABELS[support.cli]}</td>
                      <td>{support.note ?? ""}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </article>
          <nav class="guide-pager" aria-label="Previous and next page">
            {previous ? <a href={guideHref(previous)} rel="prev"><span>Previous</span>{previous.data.title}</a> : <span />}
            {next ? <a href={guideHref(next)} rel="next"><span>Next</span>{next.data.title}</a> : <span />}
          </nav>
          <p class="guide-edit">Something wrong or out of date? <a href={editUrl} target="_blank" rel="noopener">Suggest an edit on GitHub</a>.</p>
        </div>
      </div>
    </section>
  </main>
</Base>
<script>
  // The page list is a sidebar on wide screens and a collapsed menu on narrow
  // ones, where it would otherwise push the article far down. It renders open,
  // so it still works without this script.
  const menu = document.querySelector<HTMLDetailsElement>("[data-guide-nav]");
  if (menu && matchMedia("(max-width: 900px)").matches) menu.open = false;
</script>
