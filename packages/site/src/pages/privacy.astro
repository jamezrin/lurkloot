---
import { marked } from "marked";
import Base from "../layouts/SitePage.astro";
import source from "../../../../privacy-policy.md?raw";
// Preserve the policy shared with the extension and store verbatim. Only add
// stable heading anchors to its rendered HTML for the table of contents.
const body = source.replace(/^#\s.*\n/, "");
const contents: { id: string; title: string }[] = [];
const html = String(marked.parse(body, { gfm: true, breaks: false })).replace(/<h2>(.*?)<\/h2>/g, (_, title: string) => {
  const id = `policy-${contents.length + 1}`;
  contents.push({ id, title: title.replace(/<[^>]*>/g, "") });
  return `<h2 id="${id}">${title}</h2>`;
});
---
<Base title="Privacy Policy — Lurkloot" description="Lurkloot keeps settings and logs on your device, sends no analytics, and contacts platforms and opt-in reward providers directly. Read the privacy policy.">
  <main id="content">
    <header class="document-hero home-wrap"><p class="document-label">PRIVACY</p><h1>Your session.<br /><span>Your business.</span></h1><p>Privacy Policy</p></header>
    <section class="home-light document-section">
      <div class="home-wrap document-layout">
        <nav class="document-toc" aria-label="Policy sections"><p>IN THIS POLICY</p>{contents.map(item => <a href={`#${item.id}`}>{item.title}</a>)}</nav>
        <article class="document-prose" aria-label="Privacy Policy" set:html={html}></article>
      </div>
    </section>
  </main>
</Base>
