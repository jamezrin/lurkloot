---
import Base from "../layouts/Base.astro";
import Navigation from "../components/home/Navigation.astro";
import Footer from "../components/home/Footer.astro";
import Opening from "../components/home/Opening.astro";
import Workflow from "../components/home/Workflow.astro";
import RunAnywhere from "../components/home/RunAnywhere.astro";
import Questions from "../components/home/Questions.astro";
import Closing from "../components/home/Closing.astro";
import { homeFaqItems } from "../homeFaq";
import "../styles/home.css";
---
<Base faq={homeFaqItems} theme="mono">
  <a class="home-skip" href="#content">Skip to content</a>
  <div class="home">
    <Navigation />
    <main id="content">
      <Opening />
      <Workflow />
      <RunAnywhere />
      <Questions />
      <Closing />
    </main>
    <Footer />
  </div>
</Base>

<script>
  import "../scripts/home-motion.ts";
</script>
