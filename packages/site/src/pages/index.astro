---
// Follows the production homepage's story (opening demo, the three steps, the
// farming order, the platforms, two ways to run it, questions, closing call)
// with the signal theme's colour fields and scroll scenes, plus the feature
// card in between.
import Base from "../layouts/Base.astro";
import Nav from "../components/signal/Nav.astro";
import Hero from "../components/signal/Hero.astro";
import Workflow from "../components/signal/Workflow.astro";
import Priorities from "../components/signal/Priorities.astro";
import Platforms from "../components/signal/Platforms.astro";
import Features from "../components/signal/Features.astro";
import RunAnywhere from "../components/signal/RunAnywhere.astro";
import Faq from "../components/signal/Faq.astro";
import Cta from "../components/signal/Cta.astro";
import Footer from "../components/home/Footer.astro";
import { homeFaqItems } from "../homeFaq";
import "../styles/signal.css";
---
<Base faq={homeFaqItems} theme="signal">
  <a class="sg-skip" href="#content">Skip to content</a>
  <div class="signal">
    <Nav />
    <main id="content">
      <Hero />
      <Workflow />
      <Priorities />
      <Platforms />
      <Features />
      <RunAnywhere />
      <Faq />
      <Cta />
    </main>
    <Footer />
  </div>
</Base>

<script>
  import "../scripts/signal-motion.ts";
</script>
