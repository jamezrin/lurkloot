{
  "name": "@lurkloot/extension",
  "version": "1.20.0",
  "description": "Cross-browser Twitch and Kick drops farming WebExtension using visible muted tabs.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "kick:inspect": "node scripts/kick-inspect.mjs",
    "store:generate": "pnpm build && node scripts/store/cli.mjs generate",
    "store:generate:screenshots": "pnpm build && node scripts/store/cli.mjs generate screenshots",
    "store:generate:promo": "pnpm build && node scripts/store/cli.mjs generate promo",
    "store:generate:descriptions": "node scripts/store/cli.mjs generate descriptions",
    "store:validate": "node scripts/store/cli.mjs validate",
    "store:sync": "node scripts/store/cli.mjs sync",
    "store:verify": "node scripts/store/cli.mjs verify",
    "store:snapshot": "node scripts/store/cli.mjs snapshot"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@lurkloot/core": "workspace:*",
    "@lurkloot/locales": "workspace:*",
    "@lurkloot/popup-ui": "workspace:*",
    "@lurkloot/shared": "workspace:*",
    "@lurkloot/store-sync": "workspace:*",
    "@vitejs/plugin-react": "^6.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "lucide-react": "^1.0.0",
    "motion": "^14.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wxt": "^0.20.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.0",
    "linkedom": "0.18.14",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  }
}
