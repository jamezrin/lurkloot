{
  "name": "@lurkloot/store-sync",
  "version": "0.1.0",
  "description": "Syncs a directory of store listing content to the Chrome Web Store Developer Dashboard. Knows nothing about what is in it.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "store-sync": "./src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./cli": "./src/cli.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
